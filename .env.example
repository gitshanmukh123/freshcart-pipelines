# Copy this file to .env and fill in your own Snowflake account details.
# Never commit .env or any real credentials.

SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=your.name@example.com
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FRESHCART_WH
SNOWFLAKE_DATABASE=FRESHCART
SNOWFLAKE_SCHEMA=BRONZE

# If your account does not use browser-based SSO, set the authenticator and
# password instead. Do not commit the completed file.
# SNOWFLAKE_AUTHENTICATOR=snowflake
# SNOWFLAKE_PASSWORD=
